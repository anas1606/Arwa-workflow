generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id      String  @id @default(uuid())
  name    String
  email   String? @unique
  phone   String?
  balance Float   @default(0)
  code    String?
  region  String?

  // Audit fields
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  brands     Brand[]
}

model Brand {
  id          String  @id @default(uuid())
  customer_id String
  brandname   String
  description String?

  customer Customer @relation(fields: [customer_id], references: [id])

  // Audit fields
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  stickers   Sticker[]
}

model Sticker {
  id       String @id @default(uuid())
  brand_id String
  name     String

  brand Brand @relation(fields: [brand_id], references: [id])

  // Audit fields
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
}

model Category {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true) @map("is_active")

  // Self-referential relationship
  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  // Audit fields
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
}

model Unit {
  id           String  @id @default(uuid())
  name         String
  shortName    String? @map("short_name")
  quantityUnit Int     @default(1) @map("quantity_unit")
  productCount Int     @default(0) @map("product_count")
  status       Boolean @default(true)

  products Product[]

  // Audit fields
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
}

model Product {
  id                String   @id @default(uuid())
  name              String
  code              String?  @unique
  stockQuantity     Float    @default(0) @map("stock_quantity")
  lowStockThreshold Float    @default(10) @map("low_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")

  // Relationships
  categoryId    String?   @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id])
  
  unitId        String?   @map("unit_id")
  unit          Unit?     @relation(fields: [unitId], references: [id])

  // Audit fields
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  updatedBy     String?   @map("updated_by")
  is_deleted    Boolean   @default(false)
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique
  phone            String?      @unique
  email            String?      @unique
  password         String       // Encrypted password
  
  security_role_id String?
  security_role    SecurityRole? @relation(fields: [security_role_id], references: [id])
  
  isActive         Boolean      @default(true)

  // Audit fields
  createdAt        DateTime     @default(now()) @map("created_at")
  createdBy        String?      @map("created_by")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  updatedBy        String?      @map("updated_by")
  is_deleted       Boolean      @default(false)
  deletedAt        DateTime?    @map("deleted_at")
  deletedBy        String?      @map("deleted_by")
}

model SecurityRole {
  id               String       @id @default(uuid())
  role_name        String       @unique
  role_number      Int?         // Role number for hierarchy/sorting

  users            User[]
  permissions      RolePermission[]

  // Audit fields
  createdAt        DateTime     @default(now()) @map("created_at")
  createdBy        String?      @map("created_by")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  updatedBy        String?      @map("updated_by")
  is_deleted       Boolean      @default(false)
  deletedAt        DateTime?    @map("deleted_at")
  deletedBy        String?      @map("deleted_by")
}

model Module {
  id               String       @id @default(uuid())
  module_key       String       @unique // e.g., "dashboard", "customers", "products", "settings"
  name             String       // Human readable name

  permissions      RolePermission[]

  // Audit fields
  createdAt        DateTime     @default(now()) @map("created_at")
}

model RolePermission {
  id               String       @id @default(uuid())
  
  security_role_id String
  security_role    SecurityRole @relation(fields: [security_role_id], references: [id], onDelete: Cascade)
  
  module_key       String
  module           Module       @relation(fields: [module_key], references: [module_key], onDelete: Cascade)

  can_read         Boolean      @default(false)
  can_create       Boolean      @default(false)
  can_update       Boolean      @default(false)
  can_delete       Boolean      @default(false)

  @@unique([security_role_id, module_key])
}
