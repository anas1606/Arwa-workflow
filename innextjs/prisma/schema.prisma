generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id         String    @id @default(uuid())
  name       String
  email      String?   @unique
  phone      String?
  balance    Float     @default(0)
  code       String?
  region     String?
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  brands     Brand[]
  orders     Order[]
  packagings Packaging[]
}

model Brand {
  id          String    @id @default(uuid())
  customer_id String
  brandname   String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  is_deleted  Boolean   @default(false)
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  customer    Customer  @relation(fields: [customer_id], references: [id])
  stickers    Sticker[]
  orderLines  OrderLine[]
}

model Sticker {
  id         String    @id @default(uuid())
  brand_id   String
  name       String
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  brand      Brand     @relation(fields: [brand_id], references: [id])
  orderLines OrderLine[]
}

model Category {
  id         String     @id @default(uuid())
  name       String
  isActive   Boolean    @default(true) @map("is_active")
  parentId   String?    @map("parent_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  createdBy  String?    @map("created_by")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  updatedBy  String?    @map("updated_by")
  is_deleted Boolean    @default(false)
  deletedAt  DateTime?  @map("deleted_at")
  deletedBy  String?    @map("deleted_by")
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  products   Product[]
}

model Unit {
  id           String    @id @default(uuid())
  name         String
  shortName    String?   @map("short_name")
  quantityUnit Int       @default(1) @map("quantity_unit")
  productCount Int       @default(0) @map("product_count")
  status       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  is_deleted   Boolean   @default(false)
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  products     Product[]
}

model Product {
  id                String              @id @default(uuid())
  name              String
  code              String?             @unique
  stockQuantity     Float               @default(0) @map("stock_quantity")
  isActive          Boolean             @default(true) @map("is_active")
  categoryId        String?             @map("category_id")
  unitId            String?             @map("unit_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  createdBy         String?             @map("created_by")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  updatedBy         String?             @map("updated_by")
  is_deleted        Boolean             @default(false)
  deletedAt         DateTime?           @map("deleted_at")
  deletedBy         String?             @map("deleted_by")
  lowStockThreshold Float               @default(10) @map("low_stock_threshold")
  category          Category?           @relation(fields: [categoryId], references: [id])
  unit              Unit?               @relation(fields: [unitId], references: [id])
  bodyDesigns       ProductBodyDesign[]
  colours           ProductColour[]
  orderLines        OrderLine[]
}

model User {
  id               String        @id @default(uuid())
  username         String        @unique
  phone            String?       @unique
  email            String?       @unique
  password         String
  security_role_id String?
  isSuperAdmin     Boolean       @default(false)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at")
  createdBy        String?       @map("created_by")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  updatedBy        String?       @map("updated_by")
  is_deleted       Boolean       @default(false)
  deletedAt        DateTime?     @map("deleted_at")
  deletedBy        String?       @map("deleted_by")
  security_role    SecurityRole? @relation(fields: [security_role_id], references: [id])
}

model SecurityRole {
  id          String           @id @default(uuid())
  role_name   String           @unique
  role_number Int?
  createdAt   DateTime         @default(now()) @map("created_at")
  createdBy   String?          @map("created_by")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  updatedBy   String?          @map("updated_by")
  is_deleted  Boolean          @default(false)
  deletedAt   DateTime?        @map("deleted_at")
  deletedBy   String?          @map("deleted_by")
  permissions RolePermission[]
  users       User[]
}

model Module {
  id          String           @id @default(uuid())
  module_key  String           @unique
  name        String
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
}

model Setting {
  id         String    @id @default(uuid())
  key        String    @unique
  value      String
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
}

model RolePermission {
  id               String       @id @default(uuid())
  security_role_id String
  module_key       String
  can_read         Boolean      @default(false)
  can_create       Boolean      @default(false)
  can_update       Boolean      @default(false)
  can_delete       Boolean      @default(false)
  module           Module       @relation(fields: [module_key], references: [module_key], onDelete: Cascade)
  security_role    SecurityRole @relation(fields: [security_role_id], references: [id], onDelete: Cascade)

  @@unique([security_role_id, module_key])
}

model ProductBodyDesign {
  id        String       @id @default(uuid())
  productId String       @map("product_id")
  name      String
  type      StandardType
  createdAt DateTime     @default(now()) @map("created_at")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]
}

model ProductColour {
  id        String       @id @default(uuid())
  productId String       @map("product_id")
  name      String
  type      StandardType
  createdAt DateTime     @default(now()) @map("created_at")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]
}

model Packaging {
  id         String    @id @default(uuid())
  name       String
  customerId String    @map("customer_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  customer   Customer  @relation(fields: [customerId], references: [id])
  orderLines OrderLine[]
}

enum StandardType {
  STANDARD
  NON_STANDARD
}

enum OrderType {
  STANDARD
  CUSTOMIZE
  HYBRID
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum CustomisationType {
  STANDARD
  CUSTOMIZE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model Order {
  id         String   @id @default(uuid())
  orderNumber String  @unique @default(uuid()) // fallback since we don't have a sequence setup, we can use an auto-increment or similar if needed. For now uuid.
  customerId String   @map("customer_id")
  dueDate    DateTime @map("due_date")
  priority   Priority @default(NORMAL)
  remark     String?  @db.Text
  status     OrderStatus @default(DRAFT) 
  orderType  OrderType   @default(STANDARD) @map("order_type")
  
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  customer   Customer    @relation(fields: [customerId], references: [id])
  orderLines OrderLine[]
}

model OrderLine {
  id           String @id @default(uuid())
  orderId      String @map("order_id")
  productId    String @map("product_id")
  quantity     Float  @default(1)

  bodyDesignId String? @map("body_design_id")
  colourId     String? @map("colour_id")
  brandId      String? @map("brand_id")
  stickerId    String? @map("sticker_id")
  isDefaultSticker   Boolean @default(false) @map("is_default_sticker")
  
  accessoriesType CustomisationType @default(STANDARD) @map("accessories_type")
  accessoriesNote String?           @db.Text @map("accessories_note")
  
  packingType     CustomisationType @default(STANDARD) @map("packing_type")
  packingNote     String?           @db.Text @map("packing_note")
  packagingId     String?           @map("packaging_id")
  isDefaultPackaging Boolean @default(false) @map("is_default_packaging")
  orderType       CustomisationType @default(STANDARD) @map("order_type")

  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")

  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product            @relation(fields: [productId], references: [id])
  bodyDesign ProductBodyDesign? @relation(fields: [bodyDesignId], references: [id])
  colour     ProductColour?     @relation(fields: [colourId], references: [id])
  brand      Brand?             @relation(fields: [brandId], references: [id])
  sticker    Sticker?           @relation(fields: [stickerId], references: [id])
  packaging  Packaging?         @relation(fields: [packagingId], references: [id])
}

model Box {
  id         String    @id @default(uuid())
  name       String
  
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  sections   Section[]
}

model Section {
  id         String    @id @default(uuid())
  name       String
  boxId      String    @map("box_id")
  
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  box        Box       @relation(fields: [boxId], references: [id], onDelete: Cascade)
  trays      Tray[]
}

model Tray {
  id         String    @id @default(uuid())
  name       String
  sectionId  String    @map("section_id")
  
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")

  section    Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}