generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id         String    @id @default(uuid())
  name       String
  email      String?   @unique
  phone      String?
  balance    Float     @default(0)
  code       String?
  region     String?
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  brands     Brand[]
}

model Brand {
  id          String    @id @default(uuid())
  customer_id String
  brandname   String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  createdBy   String?   @map("created_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  updatedBy   String?   @map("updated_by")
  is_deleted  Boolean   @default(false)
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  customer    Customer  @relation(fields: [customer_id], references: [id])
  stickers    Sticker[]
}

model Sticker {
  id         String    @id @default(uuid())
  brand_id   String
  name       String
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  brand      Brand     @relation(fields: [brand_id], references: [id])
}

model Category {
  id         String     @id @default(uuid())
  name       String
  isActive   Boolean    @default(true) @map("is_active")
  parentId   String?    @map("parent_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  createdBy  String?    @map("created_by")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  updatedBy  String?    @map("updated_by")
  is_deleted Boolean    @default(false)
  deletedAt  DateTime?  @map("deleted_at")
  deletedBy  String?    @map("deleted_by")
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryHierarchy")
  products   Product[]
}

model Unit {
  id           String    @id @default(uuid())
  name         String
  shortName    String?   @map("short_name")
  quantityUnit Int       @default(1) @map("quantity_unit")
  productCount Int       @default(0) @map("product_count")
  status       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  createdBy    String?   @map("created_by")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  updatedBy    String?   @map("updated_by")
  is_deleted   Boolean   @default(false)
  deletedAt    DateTime? @map("deleted_at")
  deletedBy    String?   @map("deleted_by")
  products     Product[]
}

model Product {
  id                String              @id @default(uuid())
  name              String
  code              String?             @unique
  stockQuantity     Float               @default(0) @map("stock_quantity")
  isActive          Boolean             @default(true) @map("is_active")
  categoryId        String?             @map("category_id")
  unitId            String?             @map("unit_id")
  createdAt         DateTime            @default(now()) @map("created_at")
  createdBy         String?             @map("created_by")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  updatedBy         String?             @map("updated_by")
  is_deleted        Boolean             @default(false)
  deletedAt         DateTime?           @map("deleted_at")
  deletedBy         String?             @map("deleted_by")
  lowStockThreshold Float               @default(10) @map("low_stock_threshold")
  packagings        Packaging[]
  category          Category?           @relation(fields: [categoryId], references: [id])
  unit              Unit?               @relation(fields: [unitId], references: [id])
  bodyDesigns       ProductBodyDesign[]
  colours           ProductColour[]
}

model User {
  id               String        @id @default(uuid())
  username         String        @unique
  phone            String?       @unique
  email            String?       @unique
  password         String
  security_role_id String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now()) @map("created_at")
  createdBy        String?       @map("created_by")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  updatedBy        String?       @map("updated_by")
  is_deleted       Boolean       @default(false)
  deletedAt        DateTime?     @map("deleted_at")
  deletedBy        String?       @map("deleted_by")
  security_role    SecurityRole? @relation(fields: [security_role_id], references: [id])
}

model SecurityRole {
  id          String           @id @default(uuid())
  role_name   String           @unique
  role_number Int?
  createdAt   DateTime         @default(now()) @map("created_at")
  createdBy   String?          @map("created_by")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  updatedBy   String?          @map("updated_by")
  is_deleted  Boolean          @default(false)
  deletedAt   DateTime?        @map("deleted_at")
  deletedBy   String?          @map("deleted_by")
  permissions RolePermission[]
  users       User[]
}

model Module {
  id          String           @id @default(uuid())
  module_key  String           @unique
  name        String
  createdAt   DateTime         @default(now()) @map("created_at")
  permissions RolePermission[]
}

model RolePermission {
  id               String       @id @default(uuid())
  security_role_id String
  module_key       String
  can_read         Boolean      @default(false)
  can_create       Boolean      @default(false)
  can_update       Boolean      @default(false)
  can_delete       Boolean      @default(false)
  module           Module       @relation(fields: [module_key], references: [module_key], onDelete: Cascade)
  security_role    SecurityRole @relation(fields: [security_role_id], references: [id], onDelete: Cascade)

  @@unique([security_role_id, module_key])
}

model ProductBodyDesign {
  id        String       @id @default(uuid())
  productId String       @map("product_id")
  name      String
  type      StandardType
  createdAt DateTime     @default(now()) @map("created_at")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductColour {
  id        String       @id @default(uuid())
  productId String       @map("product_id")
  name      String
  type      StandardType
  createdAt DateTime     @default(now()) @map("created_at")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Packaging {
  id         String    @id @default(uuid())
  name       String
  productId  String    @map("product_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  String?   @map("created_by")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  updatedBy  String?   @map("updated_by")
  is_deleted Boolean   @default(false)
  deletedAt  DateTime? @map("deleted_at")
  deletedBy  String?   @map("deleted_by")
  product    Product   @relation(fields: [productId], references: [id])
}

enum StandardType {
  STANDARD
  NON_STANDARD
}
